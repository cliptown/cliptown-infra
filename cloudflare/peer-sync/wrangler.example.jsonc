{
  "name": "cliptown-peer-sync",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-11-22",
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "database_name": "cliptown-peer-sync",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{"name": "PEER_ROOM", "class_name": "PeerRoom"}]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["PeerRoom"]}
  ]
}
