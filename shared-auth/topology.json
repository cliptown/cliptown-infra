{
  "contract": "SharedAuthTopology",
  "version": 1,
  "githubOrg": "cliptown",
  "integration": "ores-middleware",
  "supabase": {"runtimeOrg":"oresoftware","targetOrg":"cliptown","placement":"shared-org-schema","schema":"cliptown","authDatabaseUrlEnv":"SUPABASE_AUTH_DATABASE_URL","adminDatabaseUrlEnv":"SUPABASE_ADMIN_DATABASE_URL"},
  "neon": {"runtimeOrg":"cliptown","targetOrg":"cliptown","placement":"dedicated-org","schema":"cliptown","authDatabaseUrlEnv":"NEON_AUTH_DATABASE_URL","adminDatabaseUrlEnv":"NEON_ADMIN_DATABASE_URL"},
  "requestPolicy": {"requireBothProvidersConfigured":true,"customerMode":"availability-first","adminMode":"strict-paired","sensitiveMode":"strict-paired","rejectProviderDisagreement":true},
  "roles": {
    "webServer": {"dataPlane":"customer-auth","supabaseDatabaseUrlEnv":"SUPABASE_AUTH_DATABASE_URL","neonDatabaseUrlEnv":"NEON_AUTH_DATABASE_URL"},
    "apiServer": {"dataPlane":"customer-auth","supabaseDatabaseUrlEnv":"SUPABASE_AUTH_DATABASE_URL","neonDatabaseUrlEnv":"NEON_AUTH_DATABASE_URL"},
    "adminWebServer": {"dataPlane":"admin-auth","supabaseDatabaseUrlEnv":"SUPABASE_ADMIN_DATABASE_URL","neonDatabaseUrlEnv":"NEON_ADMIN_DATABASE_URL"},
    "adminApiServer": {"dataPlane":"admin-auth","supabaseDatabaseUrlEnv":"SUPABASE_ADMIN_DATABASE_URL","neonDatabaseUrlEnv":"NEON_ADMIN_DATABASE_URL"}
  },
  "auditRepositories": ["cliptown/cliptown-web-server.rs","cliptown/cliptown-api-server.rs","cliptown/cliptown-admin-web-server.rs","cliptown/cliptown-admin-api-server.rs","cliptown/cliptown-infra"]
}
